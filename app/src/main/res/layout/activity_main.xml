<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fondopantalla"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/contenedor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="30dp"
        app:cardElevation="35dp"
        app:cardCornerRadius="25dp"
        android:backgroundTint="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio Sesion"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#395886"
                android:layout_margin="15dp"
                android:layout_marginBottom="30dp" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Correo Electronico"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:textColor="#333333"
                android:textColorHint="#000000"
                android:inputType="textEmailAddress"
                android:drawablePadding="10dp"
                android:background="@drawable/bg_imput"
                android:drawableStart="@drawable/mail_24dp_e3e3e3_fill0_wght400_grad0_opsz24" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Contraseña"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:textColor="#333333"
                android:textColorHint="#000000"
                android:inputType="textPassword"
                android:drawablePadding="10dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_imput"
                android:drawableStart="@drawable/key_24dp_e3e3e3_fill0_wght400_grad0_opsz24"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_button"
                android:layout_marginTop="25dp"
                android:text="INGRESAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"

                android:textSize="15sp"/>


            <TextView
                android:id="@+id/tvCrearCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crea una cuenta ->"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="20dp"
                android:textStyle="bold"
                android:textColor="#395886"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>